# ── MYTHORA PRODUCTION ENVIRONMENT CONFIGURATION ──
# Note: Never commit production credentials to source control.

# Database (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=storyweave

# AI & Embedding Engine
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest
CHROMA_PERSIST_DIRECTORY=./data/chroma
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Server & Security
ENVIRONMENT=production
LOG_LEVEL=INFO
APP_NAME=Mythora
APP_VERSION=0.1.0
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=https://mythora.vercel.app,http://localhost:5173

# Frontend Environment Variable (Set in Vercel Dashboard)
# VITE_API_BASE_URL=https://mythora-backend.onrender.com
